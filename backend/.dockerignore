# Ignore Python virtual environments
.venv/
.venv_linux/

# Ignore Python cache directories
__pycache__/
*.pyc
*.pyo

# Ignore pytest cache
.pytest_cache/

# Ignore editor/IDE specific files
.vscode/
.idea/

# Ignore logs and temporary files
*.log
*.tmp
tmp/

# Ignore environment variables file
.env

# Ignore media files (if they are not meant to be part of the image)
media/

# Ignore Scrapy output log
scrapy_output.log

# Ignore test http file
teste.http
